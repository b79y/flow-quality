__DEVICE__
ColorSpace = "NoOp"
Title = "Punchy Saturation"
Description = "Vibrant, skin-safe boost"

__CONST__

__END__

__KERNEL__

__DEVICE__ float3 apply(float3 c)
{
    float l = dot(c, make_float3(0.2126, 0.7152, 0.0722)); c = l + (c - l) * 1.22; c.r = clamp(c.r, 0.0, 1.0); c.g = clamp(c.g, 0.0, 1.0); c.b = clamp(c.b, 0.0, 1.0); return c;
}

__DEVICE__ void transform(PS_INPUT input, __TEXTURE__ tex, __CALLBACK_INSTANCE__ instance, float4 result)
{
    float3 col = _fetchPixel(tex, input.pos).rgb;
    col = apply(col);
    result.rgb = col;
    result.a = 1.0;
}
__END__
