__DEVICE__
ColorSpace = "NoOp"
Title = "Soft Fade"
Description = "Elevated blacks, lowered whites"

__CONST__

__END__

__KERNEL__

__DEVICE__ float3 apply(float3 c)
{
    c.r = 0.05 + c.r * 0.92; c.g = 0.05 + c.g * 0.92; c.b = 0.05 + c.b * 0.92; float l = dot(c, make_float3(0.2126, 0.7152, 0.0722)); c = c + (l - c) * 0.12; return c;
}

__DEVICE__ void transform(PS_INPUT input, __TEXTURE__ tex, __CALLBACK_INSTANCE__ instance, float4 result)
{
    float3 col = _fetchPixel(tex, input.pos).rgb;
    col = apply(col);
    result.rgb = col;
    result.a = 1.0;
}
__END__
