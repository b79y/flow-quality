{
  "name": "flow-quality",
  "version": "2.0.0",
  "description": "FLOW Quality - Video Optimization Studio for TikTok, Shorts & Reels",
  "author": "FLOW Quality Team",
  "license": "Proprietary",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "release": "npm run build && electron-builder --win --config electron-builder.yml --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@ffprobe-installer/win32-x64": "^5.1.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.21.5": true
  }
}
